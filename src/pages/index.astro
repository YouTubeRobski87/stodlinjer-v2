---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SupportLineCard from "../components/SupportLineCard.astro";
import SupportLineDetail from "../components/SupportLineDetail.astro";
import SearchBar from "../components/SearchBar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Icon from "../components/Icon.astro";
import categoriesData from "../content/categories.json";
import { detailHours, closedDays, type Hours } from "../lib/hours";
import { facetLabel } from "../lib/labels";
import StructuredData from "../components/StructuredData.astro";
import { absoluteUrl, SITE_NAME, SITE_URL, siteOrganization } from "../lib/structuredData";

const categories = categoriesData;
const catById = Object.fromEntries(categories.map((c) => [c.id, c]));

// Real support-line data → the card grid. Active only, featured first,
// then by display priority, then alphabetically (Swedish collation).
const lines = (await getCollection("supportLines", (e) => e.data.status === "active"))
  .sort((a, b) => {
    const f = Number(b.data.display.featured) - Number(a.data.display.featured);
    if (f !== 0) return f;
    const p = b.data.display.priority - a.data.display.priority;
    if (p !== 0) return p;
    return a.data.name.localeCompare(b.data.name, "sv");
  });

type Line = (typeof lines)[number];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      name: SITE_NAME,
      url: absoluteUrl(),
      publisher: { "@id": `${SITE_URL}/#organization` },
    },
    siteOrganization(),
  ],
};

// The headline contact (phone first, else the first method that can be
// acted on) drives the foot value, its icon, the link, and the hours
// popover. The website comes from source.primaryUrl.
function cardPropsOf(line: Line) {
  const cm = line.data.contactMethods;
  const headline =
    cm.find((c) => c.channel === "phone" && c.value) ??
    cm.find((c) => c.value || c.url) ??
    cm[0];

  const channel = headline.channel;
  const isPhone = channel === "phone";

  // Phones show the number; everything else shows the curated action label.
  const primaryValue = isPhone
    ? (headline.value ?? line.data.display.primaryLabel)
    : (headline.label ?? line.data.display.primaryLabel);

  const primaryHref = isPhone
    ? headline.value
      ? `tel:${headline.value.replace(/\D/g, "")}`
      : null
    : (headline.url ?? null);

  const entries = (headline.openingHours ?? []) as Hours[];
  const hoursDetail = detailHours(entries);
  const hoursClosed = closedDays(entries);

  return {
    primaryValue,
    primaryChannel: channel,
    primaryHref,
    hoursDetail,
    hoursClosed,
    website: line.data.source.primaryUrl ?? null,
  };
}
---

<BaseLayout title="Stödlinjer Sverige | Hitta rätt hjälp direkt">
  <StructuredData data={structuredData} />
  <SiteHeader />

  <main id="main">
    <section class="hero container--wide">
      <p class="hero__eyebrow mono">{lines.length} stödlinjer · {categories.length} kategorier</p>
      <h1 class="hero__title">Behöver du hjälp nu?</h1>
      <p class="hero__lede">
        Hitta rätt stöd när du behöver det – via telefon, chatt eller webb.
      </p>

      <div class="hero-search" role="search">
        <span class="hero-search__icon" aria-hidden="true">
          <Icon name="round-magnifying-glass" size={22} />
        </span>
        <label for="line-search" class="sr-only">Sök stödlinjer och artiklar</label>
        <input
          id="line-search"
          type="search"
          class="js-line-search hero-search__input"
          placeholder="Sök stöd — t.ex. ångest, våld, ekonomi…"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="hero-search__kbd" aria-hidden="true">⌘K</kbd>
      </div>

      <div class="pills-wrap">
        <button
          class="pills-nav pills-nav--left"
          type="button"
          aria-label="Bläddra kategorier åt vänster"
          tabindex="-1"
        >
          <Icon name="left-chevron" size={18} />
        </button>
        <div class="pills" role="group" aria-label="Filtrera efter kategori">
          <button class="pill" data-filter="all" aria-pressed="true">
            <Icon name="nine-square-application-grid" size={17} />
            Alla
          </button>
          {
            categories.map((c) => (
              <button class="pill" data-filter={c.id} aria-pressed="false">
                <Icon name={c.icon} size={17} />
                {c.label}
              </button>
            ))
          }
        </div>
        <button
          class="pills-nav pills-nav--right"
          type="button"
          aria-label="Bläddra kategorier åt höger"
          tabindex="-1"
        >
          <Icon name="right-chevron" size={18} />
        </button>
      </div>
    </section>

    <section id="stodlinjer" class="lines container--wide">
      {/* Group headings appear only while a search is active. With an empty
          query the page reads exactly as before: one unlabelled card grid. */}
      <h2 id="lines-heading" class="results__heading" hidden>
        Stödlinjer <span class="results__count mono" id="lines-count"></span>
      </h2>

      <div class="grid">
        {
          lines.map((line) => {
            const cat = catById[line.data.category.id];
            const cp = cardPropsOf(line);
            return (
              <SupportLineCard
                name={line.data.name}
                shortDescription={line.data.shortDescription}
                categoryColor={cat.color}
                categoryIcon={cat.icon}
                categoryId={cat.id}
                categoryLabel={cat.label}
                primaryValue={cp.primaryValue}
                primaryChannel={cp.primaryChannel}
                primaryHref={cp.primaryHref}
                hoursDetail={cp.hoursDetail}
                hoursClosed={cp.hoursClosed}
                website={cp.website}
                keywords={[
                  ...cat.keywords,
                  ...line.data.helpsWith,
                  // Both spellings in the index: the ascii slug and the
                  // Swedish label, so "angest" and "ångest" both match.
                  ...line.data.helpsWith.map(facetLabel),
                ]}
                href={`/stodlinjer/${line.data.slug}/`}
              />
            );
          })
        }
      </div>

      <p id="grid-empty" class="grid__empty" hidden>
        Inga stödlinjer matchar din sökning.
      </p>

      <h2 id="articles-heading" class="results__heading" hidden>
        Artiklar <span class="results__count mono" id="articles-count"></span>
      </h2>
      <div class="grid" id="article-results" hidden></div>

      {/* Shown only when both groups are empty, so a miss reads as one calm
          message rather than two separate failures. */}
      <p id="search-empty" class="grid__empty" hidden>
        Inga träffar på din sökning.
      </p>

      <p class="sr-only" id="results-status" role="status" aria-live="polite"></p>
    </section>

    {/* Cloned per article hit. Authored here (not built as a string in JS) so
        Astro's scoped styles apply to the cloned nodes. */}
    <template id="article-result-tpl">
      <article class="aresult">
        <span class="aresult__rule" aria-hidden="true"></span>
        <span class="aresult__kind mono" data-kind></span>
        <a class="aresult__title" data-title href="#"></a>
        <p class="aresult__desc" data-desc></p>
      </article>
    </template>

  </main>

  <SiteFooter />

  <SearchBar />

  <dialog class="line-modal" id="line-modal" aria-label="Stödlinje">
    <button class="line-modal__close" type="button" aria-label="Stäng" data-modal-close>
      <Icon name="diagonal-cross-mark" size={16} />
    </button>
    <div class="line-modal__inner" data-modal-inner>
      {
        lines.map((line) => (
          <div class="line-panel" data-slug={line.data.slug} hidden>
            <SupportLineDetail line={line} />
          </div>
        ))
      }
    </div>
  </dialog>
</BaseLayout>

<style>
  /* ── Hero ───────────────────────────────────────────────── */
  .hero {
    text-align: center;
    /* Compact enough that the search field + category filters clear the fold
       on a laptop — the hero is an entry point, not a landing splash. */
    padding-block: clamp(var(--space-8), 5vw, var(--space-16)) var(--space-8);
  }
  .hero__eyebrow {
    font-size: 0.8125rem;
    letter-spacing: 0.02em; /* System Mono is already wide — ease the tracking */
    color: var(--subtle);
    margin-bottom: var(--space-6);
  }
  .hero__title {
    /* Kept at 400 so GT Alpina's contrast stays elegant rather than heavy.
       Smaller than a splash headline — it frames the search, doesn't upstage it. */
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin-inline: auto;
    max-width: min(20ch, 100%);
    overflow-wrap: break-word;
  }
  .hero__title em {
    font-style: italic; /* GT Alpina's calligraphic italic is the showpiece here */
    color: var(--muted);
  }
  .hero__lede {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    color: var(--muted);
    line-height: 1.55;
    margin: var(--space-4) auto 0;
    max-width: var(--measure);
  }

  /* ── Hero search — the focal point ──────────────────────── */
  .hero-search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: min(620px, 100%);
    margin: var(--space-8) auto 0;
    padding: 14px 18px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: var(--hairline) solid var(--border-strong);
    box-shadow:
      0 1px 2px oklch(0 0 0 / 0.04),
      0 12px 28px -12px oklch(0 0 0 / 0.18);
    transition: box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .hero-search:focus-within {
    border-color: var(--accent);
    box-shadow:
      0 0 0 3px var(--accent-soft),
      0 12px 28px -12px oklch(0 0 0 / 0.2);
  }
  .hero-search__icon {
    display: flex;
    color: var(--muted);
    flex-shrink: 0;
  }
  .hero-search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    font: inherit;
    font-size: 1.125rem;
    color: var(--foreground);
  }
  .hero-search__input::placeholder {
    color: var(--subtle);
  }
  .hero-search__input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .hero-search__kbd {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    background: var(--accent-soft);
    border: var(--hairline) solid var(--border);
    border-radius: 7px;
    padding: 6px 9px;
    line-height: 1;
  }
  @media (max-width: 560px) {
    .hero-search__kbd {
      display: none;
    }
  }

  /* ── Lines section ──────────────────────────────────────── */
  .lines {
    padding-bottom: var(--space-16);
    /* Anchor jumps (/#stodlinjer) land clear of the sticky strip + header. */
    scroll-margin-top: calc(var(--acute-strip-h, 0px) + 76px);
  }
  .pills-wrap {
    position: relative;
    margin-top: var(--space-6);
  }
  .pills {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: var(--space-2);
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
  }
  .pills::-webkit-scrollbar {
    display: none;
  }

  /* Edge fades hint at off-screen pills; only shown on the scrollable side. */
  .pills-wrap::before,
  .pills-wrap::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: var(--space-2); /* sit above the scrollbar padding */
    width: 56px;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .pills-wrap::before {
    left: 0;
    background: linear-gradient(to right, var(--background), transparent);
  }
  .pills-wrap::after {
    right: 0;
    background: linear-gradient(to left, var(--background), transparent);
  }
  .pills-wrap.can-left::before,
  .pills-wrap.can-right::after {
    opacity: 1;
  }

  /* Scroll arrows — fade in on hover, only toward the side you can scroll. */
  .pills-nav {
    position: absolute;
    top: 50%;
    transform: translateY(calc(-50% - var(--space-1)));
    z-index: 2;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface);
    border: var(--hairline) solid var(--border-strong);
    color: var(--foreground);
    box-shadow: 0 2px 8px color-mix(in oklch, var(--foreground) 12%, transparent);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .pills-nav--left {
    left: -6px;
  }
  .pills-nav--right {
    right: -6px;
  }
  .pills-nav:hover {
    background: var(--hover);
    border-color: var(--border-strong);
  }
  .pills-wrap.can-left:hover .pills-nav--left,
  .pills-wrap.can-right:hover .pills-nav--right {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .pills {
      scroll-behavior: auto;
    }
  }
  /* Touch devices scroll by swipe — the arrows add no value there. */
  @media (hover: none) {
    .pills-nav {
      display: none;
    }
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    scroll-snap-align: start;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--foreground);
    background: var(--surface);
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius-lg);
    padding: 9px 16px 9px 14px;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .pill .icon {
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .pill[aria-pressed="true"] .icon {
    color: var(--accent-fg);
  }
  .pill:hover {
    background: var(--hover);
    border-color: var(--border-strong);
  }
  .pill[aria-pressed="true"] {
    background: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-4);
  }
  /* Cap at 3 columns on wide screens so cards stay generous, not stretched. */
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  /* One full-width card on phones. */
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .grid :global(.card.is-hidden) {
    display: none;
  }
  .grid__empty {
    color: var(--muted);
    text-align: center;
    padding-block: var(--space-16);
    font-size: 1rem;
  }

  /* ── Search result groups ───────────────────────────────── */
  .results__heading {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-block: var(--space-8) var(--space-4);
  }
  .results__heading:first-child {
    margin-top: 0;
  }
  .results__count {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 400;
  }

  /* Article hit. Mirrors the article card in /artiklar/ but is rendered from
     the JSON index, so it lives here rather than in ArticleCard.astro. */
  .aresult {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius-card);
    background: var(--surface);
    transition:
      transform 0.16s ease,
      border-color 0.16s ease;
  }
  .aresult:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--foreground) 22%, transparent);
  }
  .aresult__rule {
    display: block;
    width: 28px;
    height: 3px;
    border-radius: 2px;
    background: var(--accent-soft-fg, var(--accent));
  }
  .aresult__kind {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .aresult__title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--foreground);
    text-decoration: none;
  }
  /* Whole card clickable without nesting interactive elements. */
  .aresult__title::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .aresult__title:hover {
    text-decoration: underline;
  }
  .aresult__desc {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
  }

  /* ── Support-line modal ─────────────────────────────────── */
  .line-modal {
    position: relative;
    width: min(720px, 100%);
    max-width: 100%;
    max-height: min(88vh, 940px);
    margin: auto; /* centre in the viewport */
    padding: 0;
    border: var(--hairline) solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--background);
    color: var(--foreground);
    /* Two layers: a near edge to crisply define the panel against the
       blurred page, plus the deep ambient lift. */
    box-shadow:
      0 4px 16px -6px oklch(0 0 0 / 0.25),
      0 40px 90px -28px oklch(0 0 0 / 0.55);
    overflow: hidden;
  }
  .line-modal::backdrop {
    background: var(--modal-scrim);
    backdrop-filter: blur(6px) saturate(1.05);
    -webkit-backdrop-filter: blur(6px) saturate(1.05);
  }
  .line-modal__inner {
    max-height: min(88vh, 940px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-12) var(--space-8) var(--space-8);
  }
  .line-modal__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: var(--hairline) solid var(--border);
    background: var(--surface);
    color: var(--muted);
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .line-modal__close:hover {
    background: var(--hover);
    color: var(--foreground);
    border-color: var(--border-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .line-modal[open] {
      animation: modal-in 0.18s ease-out;
    }
    .line-modal[open]::backdrop {
      animation: backdrop-in 0.18s ease-out;
    }
  }
  @keyframes modal-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Phone: dock to the bottom as a sheet. */
  @media (max-width: 560px) {
    .line-modal {
      width: 100%;
      max-height: 92vh;
      margin: auto auto 0;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    }
    .line-modal__inner {
      max-height: 92vh;
      padding: var(--space-12) var(--space-6) var(--space-8);
    }
  }

  /* Lock background scroll while the modal is open. */
  :global(body.modal-open) {
    overflow: hidden;
  }
</style>

<script>
  // Owns the category pills + the two synced search fields (the hero field and
  // the floating ⌘K bar). Support lines are server-rendered cards filtered in
  // place; articles come from /search-index.json, fetched on first keystroke.
  import { fieldTokens, matchStrength, tokenize } from "../lib/searchText.ts";

  const inputs = Array.from(document.querySelectorAll<HTMLInputElement>(".js-line-search"));
  const heroInput = document.getElementById("line-search") as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-card]"));
  const pills = Array.from(document.querySelectorAll<HTMLElement>(".pill"));
  const empty = document.getElementById("grid-empty");
  const linesHeading = document.getElementById("lines-heading");
  const linesCount = document.getElementById("lines-count");
  const articlesHeading = document.getElementById("articles-heading");
  const articlesCount = document.getElementById("articles-count");
  const articleResults = document.getElementById("article-results");
  const searchEmpty = document.getElementById("search-empty");
  const status = document.getElementById("results-status");
  const tpl = document.getElementById("article-result-tpl") as HTMLTemplateElement | null;

  interface ArticleDoc {
    type: "article";
    title: string;
    description: string;
    tags: string[];
    collection: string;
    collectionLabel: string;
    url: string;
  }
  type IndexedDoc = ArticleDoc & {
    titleTokens: string[];
    tagTokens: string[];
    descTokens: string[];
  };

  let activeCat = "all";
  let query = "";
  // Guards against an earlier fetch resolving after a later keystroke.
  let runToken = 0;

  // ── Article index ────────────────────────────────────────────────
  // Fetched once, lazily. Tokenised on arrival so each keystroke only scores.
  let indexPromise: Promise<IndexedDoc[]> | null = null;
  function loadIndex(): Promise<IndexedDoc[]> {
    if (!indexPromise) {
      indexPromise = fetch("/search-index.json")
        .then((r) => (r.ok ? (r.json() as Promise<ArticleDoc[]>) : []))
        .then((docs) =>
          docs.map((d) => ({
            ...d,
            titleTokens: fieldTokens(d.title),
            tagTokens: fieldTokens(...d.tags, d.collectionLabel),
            descTokens: fieldTokens(d.description),
          })),
        )
        // Search is an enhancement — a failed fetch must never break the page.
        .catch(() => [] as IndexedDoc[]);
    }
    return indexPromise;
  }

  // Title beats tags beats description, and an exact token beats a fuzzy one
  // (×2). Without that second axis "Trygg hemma?" ties with "Trygghetsplan"
  // for the query "trygghetsplan". Every query token has to land somewhere, so
  // a second word narrows the result instead of widening it.
  // Spread so a field always outranks the one below it, even when the lower
  // field matched exactly and the higher one only fuzzily: a fuzzy title (10)
  // still beats an exact tag (6). "Title väger högst" holds unconditionally.
  const W_TITLE = 10;
  const W_TAG = 3;
  const W_DESC = 1;

  function scoreDoc(doc: IndexedDoc, tokens: string[]): number {
    let score = 0;
    for (const t of tokens) {
      const inTitle = matchStrength(doc.titleTokens, t);
      const inTags = matchStrength(doc.tagTokens, t);
      const inDesc = matchStrength(doc.descTokens, t);
      const best = Math.max(inTitle * W_TITLE, inTags * W_TAG, inDesc * W_DESC);
      if (best === 0) return 0;
      score += best;
    }
    return score;
  }

  function renderArticles(hits: IndexedDoc[]) {
    if (!articleResults || !tpl) return;
    const frag = document.createDocumentFragment();
    for (const hit of hits) {
      const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const kind = node.querySelector<HTMLElement>("[data-kind]");
      const title = node.querySelector<HTMLAnchorElement>("[data-title]");
      const desc = node.querySelector<HTMLElement>("[data-desc]");
      if (kind) kind.textContent = `Artikel · ${hit.collectionLabel}`;
      if (title) {
        title.textContent = hit.title;
        title.href = hit.url;
      }
      if (desc) desc.textContent = hit.description;
      frag.append(node);
    }
    articleResults.replaceChildren(frag);
  }

  function paint(nLines: number, nArticles: number, searching: boolean) {
    if (linesHeading) linesHeading.hidden = !searching || nLines === 0;
    if (linesCount) linesCount.textContent = String(nLines);
    if (articlesHeading) articlesHeading.hidden = !searching || nArticles === 0;
    if (articlesCount) articlesCount.textContent = String(nArticles);
    if (articleResults) articleResults.hidden = nArticles === 0;
    // The lines-only message stays for the no-query pill case; while searching
    // a miss reads as one combined message instead of two.
    if (empty) empty.hidden = searching || nLines !== 0;
    if (searchEmpty) searchEmpty.hidden = !(searching && nLines === 0 && nArticles === 0);
    if (status) {
      const l = nLines === 1 ? "1 stödlinje" : `${nLines} stödlinjer`;
      const a = nArticles === 1 ? "1 artikel" : `${nArticles} artiklar`;
      status.textContent = searching ? `${l} och ${a} matchar din sökning.` : "";
    }
  }

  function apply() {
    let visibleLines = 0;
    for (const card of cards) {
      const matchCat = activeCat === "all" || card.dataset.cat === activeCat;
      const matchText = query === "" || (card.dataset.search ?? "").includes(query);
      const show = matchCat && matchText;
      card.classList.toggle("is-hidden", !show);
      if (show) visibleLines++;
    }

    const searching = query !== "";
    // Article topics are a different taxonomy from the line categories, so the
    // pills stay a line filter and articles stand down while one is active.
    const wantArticles = searching && activeCat === "all";
    const tokens = wantArticles ? tokenize(query) : [];

    if (tokens.length === 0) {
      runToken++;
      renderArticles([]);
      paint(visibleLines, 0, searching);
      return;
    }

    const token = ++runToken;
    paint(visibleLines, 0, searching);
    void loadIndex().then((docs) => {
      if (token !== runToken) return;
      const hits = docs
        .map((d) => ({ doc: d, score: scoreDoc(d, tokens) }))
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score || a.doc.title.localeCompare(b.doc.title, "sv"))
        .map((r) => r.doc);
      renderArticles(hits);
      paint(visibleLines, hits.length, true);
    });
  }

  // One query, mirrored across every search field so the hero field and the
  // floating bar always agree.
  function setQuery(value: string) {
    query = value.trim().toLowerCase();
    for (const el of inputs) {
      if (el.value !== value) el.value = value;
    }
    apply();
  }

  for (const el of inputs) {
    el.addEventListener("input", () => setQuery(el.value));
    el.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        setQuery("");
        el.blur();
      }
    });
  }

  for (const pill of pills) {
    pill.addEventListener("click", () => {
      activeCat = pill.dataset.filter ?? "all";
      pills.forEach((p) => p.setAttribute("aria-pressed", String(p === pill)));
      apply();
    });
  }

  // Pills overflow affordance — toggle edge fades + arrows by scroll position.
  const pillsWrap = document.querySelector<HTMLElement>(".pills-wrap");
  const pillsScroller = document.querySelector<HTMLElement>(".pills");
  const navLeft = document.querySelector<HTMLElement>(".pills-nav--left");
  const navRight = document.querySelector<HTMLElement>(".pills-nav--right");

  function updatePillNav() {
    if (!pillsWrap || !pillsScroller) return;
    const { scrollLeft, scrollWidth, clientWidth } = pillsScroller;
    const max = scrollWidth - clientWidth;
    pillsWrap.classList.toggle("can-left", scrollLeft > 1);
    pillsWrap.classList.toggle("can-right", scrollLeft < max - 1);
  }

  function scrollPills(direction: number) {
    pillsScroller?.scrollBy({ left: direction * pillsScroller.clientWidth * 0.8 });
  }

  navLeft?.addEventListener("click", () => scrollPills(-1));
  navRight?.addEventListener("click", () => scrollPills(1));
  pillsScroller?.addEventListener("scroll", updatePillNav, { passive: true });
  window.addEventListener("resize", updatePillNav);
  updatePillNav();

  // ── Floating bar: reveal on scroll past the hero field ───────────
  // The hero search is primary; the floating ⌘K bar stays hidden until the hero
  // field scrolls out of view, so there are never two competing fields on
  // screen at once. It opts into the hidden state via JS, so without JS the bar
  // simply stays visible (its filtering needs JS anyway).
  const heroSearch = document.querySelector<HTMLElement>(".hero-search");
  const floatingBar = document.querySelector<HTMLElement>(".searchbar");
  const floatingInput = document.getElementById("line-search-floating") as HTMLInputElement | null;

  if (heroSearch && floatingBar) {
    floatingBar.classList.add("is-collapsible");
    const io = new IntersectionObserver(
      ([entry]) => floatingBar.classList.toggle("is-visible", !entry.isIntersecting),
      { rootMargin: "-80px 0px 0px 0px" },
    );
    io.observe(heroSearch);
  }

  // ⌘K / Ctrl+K focuses whichever field is currently on screen.
  window.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      const useFloating = floatingBar?.classList.contains("is-visible");
      (useFloating ? floatingInput : heroInput)?.focus();
    }
  });


  // ── Support-line modal ────────────────────────────────────
  // Cards keep a real href to /stodlinjer/{slug}/ (the no-JS / shareable
  // fallback). Here we intercept that click to open a modal instead and keep
  // the URL in sync via the History API, so back/forward and sharing work.
  const modal = document.getElementById("line-modal") as HTMLDialogElement | null;
  const modalInner = modal?.querySelector<HTMLElement>("[data-modal-inner]") ?? null;
  const panels = Array.from(modal?.querySelectorAll<HTMLElement>(".line-panel") ?? []);
  const panelBySlug = new Map(panels.map((p) => [p.dataset.slug ?? "", p]));
  const SLUG_RE = /^\/stodlinjer\/([^/]+)\/?$/;

  function showPanel(slug: string): boolean {
    const target = panelBySlug.get(slug);
    if (!target) return false;
    for (const p of panels) p.hidden = p !== target;
    const name = target.querySelector(".line__name")?.textContent?.trim();
    if (name) modal?.setAttribute("aria-label", name);
    return true;
  }

  function openModalUI(slug: string): boolean {
    if (!modal || !showPanel(slug)) return false;
    if (!modal.open) modal.showModal();
    document.body.classList.add("modal-open");
    if (modalInner) modalInner.scrollTop = 0;
    return true;
  }

  function closeModalUI() {
    if (modal?.open) modal.close();
    document.body.classList.remove("modal-open");
  }

  // The URL is the source of truth; the modal mirrors it.
  function navigateToLine(slug: string) {
    if (!openModalUI(slug)) return;
    history.pushState({ modal: slug }, "", `/stodlinjer/${slug}/`);
  }

  function syncToLocation() {
    const m = location.pathname.match(SLUG_RE);
    if (m && panelBySlug.has(m[1])) openModalUI(m[1]);
    else closeModalUI();
  }

  if (modal) {
    // Intercept a card's primary link → open it as a modal instead.
    document.querySelector(".grid")?.addEventListener("click", (e) => {
      const ev = e as MouseEvent;
      // Respect modifier-clicks / middle-click so "open in new tab" still works.
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;
      const link = (ev.target as HTMLElement)?.closest?.(
        "a.card__name",
      ) as HTMLAnchorElement | null;
      if (!link) return;
      const slug = link.getAttribute("href")?.match(SLUG_RE)?.[1];
      if (!slug) return;
      ev.preventDefault();
      navigateToLine(slug);
    });

    // Esc, the × button and backdrop clicks all "go back" so the URL resets;
    // popstate then drives the actual close, keeping one code path.
    modal.addEventListener("cancel", (e) => {
      e.preventDefault();
      history.back();
    });
    modal
      .querySelector("[data-modal-close]")
      ?.addEventListener("click", () => history.back());
    modal.addEventListener("click", (e) => {
      if (e.target === modal) history.back(); // backdrop
    });

    window.addEventListener("popstate", syncToLocation);
  }
</script>
