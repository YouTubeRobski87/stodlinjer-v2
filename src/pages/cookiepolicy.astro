---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout
  title="Cookiepolicy | Stödlinjer"
  description="Information om cookies för statistik på Stödlinjer.se."
>
  <SiteHeader />

  <main id="main" class="page container">
    <h1>Cookiepolicy</h1>
    <p>
      Stödlinjer.se frågar om du vill tillåta cookies för statistik. Valet är frivilligt,
      och sajten fungerar även om du tackar nej.
    </p>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .page {
    max-width: var(--content-max);
    padding-block: var(--space-12) var(--space-16);
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.01em;
  }
  p {
    max-width: var(--measure);
    margin-top: var(--space-5);
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
</style>
