---
import ThemeToggle from "./ThemeToggle.astro";
import PaletteSwitcher from "./PaletteSwitcher.astro";

// Shared sticky topbar for every page (homepage included). The two wordmark
// links — Stödlinjer (home) and Artiklar — sit together on the left, doubling
// as both brand and primary nav; the active page carries an accent underline.
// The palette switcher, theme toggle and chat CTA cluster on the right.
const path = Astro.url.pathname;
const isHome = path === "/";
const isArticles = path.startsWith("/artiklar");
---

<header class="topbar">
  <div class="topbar__inner container--wide">
    <nav class="topbar__left" aria-label="Huvudmeny">
      <a class="nav__brand" href="/" aria-current={isHome ? "page" : undefined}>Stödlinjer</a>
      <span class="nav__sep" aria-hidden="true">/</span>
      <a class="nav__brand" href="/artiklar/" aria-current={isArticles ? "page" : undefined}>Artiklar</a>
    </nav>
    <div class="nav">
      <PaletteSwitcher />
      <ThemeToggle />
      <a class="nav__cta" href="/chatt/">Fråga Stödkompassen</a>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    /* Sits flush below the sticky AcuteStrip when present (homepage); the
       variable defaults to 0 on pages without the strip. */
    top: var(--acute-strip-h, 0);
    z-index: 50;
    border-bottom: var(--hairline) solid var(--border);
    background: color-mix(in oklch, var(--background) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
  }
  /* The two wordmark links travel together on the left, reading as a unit. */
  .topbar__left {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .nav__sep {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 300;
    color: var(--muted);
    user-select: none;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: 0.9375rem;
  }
  .nav__brand {
    position: relative;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500; /* Book — holds the serif's contrast at this size */
    letter-spacing: -0.005em;
    color: var(--foreground);
  }
  /* One underline rule for both states: invisible by default, a faint accent
     preview on hover, and the full accent bar on the active page. */
  .nav__brand::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .nav__brand:hover::after {
    opacity: 0.4;
  }
  .nav__brand[aria-current="page"]::after {
    opacity: 1;
  }
  .nav__cta {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-fg);
    font-size: 0.90625rem;
    font-weight: 500;
    transition: background 0.15s ease;
  }
  .nav__cta:hover {
    background: var(--accent-hover);
  }
  /* Only two short wordmarks now, so they stay inline at every width — just
     scale them down so they share the bar with the right-hand cluster. */
  @media (max-width: 560px) {
    .nav {
      gap: var(--space-2);
    }
    .nav__brand,
    .nav__sep {
      font-size: 1.0625rem;
    }
  }
</style>
